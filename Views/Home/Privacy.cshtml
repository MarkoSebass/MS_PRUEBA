    <h1>@ViewData["Title"]</h1>
    <p>
        Descubre información importante sobre nuestra plataforma mediante
        videos, guías y recursos interactivos.
    </p>
</section>

<div class="content-panel">

    <div class="video-container">
        <iframe width="100%"
                height="500"
                src="https://www.youtube.com/embed/dQw4w9WgXcQ"
                title="Video informativo"
                frameborder="0"
                allowfullscreen>
        </iframe>
    </div>

    <div class="info-cards">
        <div class="card">
            <h>
        </div>

        <div class="card">
            <h3>📚 Recursos</h3>
            <p>
                Encuentra documentación, tutoriales y material de apoyo.
            </p>
        </div>

        <div class="card">
            <h3>🔒 Seguridad</h3>
            <p>
                Conoce cómo protegemos tu información y garantizamos tu privacidad.
            </p>
        </div>
    </div>

</div>

