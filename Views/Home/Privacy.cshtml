@{
    ViewData["Title"] = "Centro de Información";
}

<div class="content-header">
    <span class="eyebrow">RECURSOS Y AYUDA</span>

    <h1>@ViewData["Title"]</h1>

    <p>
        Encuentra tutoriales, videos, documentación y recursos para aprovechar
        al máximo todas las funcionalidades de la plataforma.
    </p>
</div>

<div class="content-panel">

    <h2>🎥 Video Destacado</h2>

    <p>
        Descubre contenido multimedia directamente desde el sistema.
    </p>

    <div class="ratio ratio-16x9 mt-3">
        <iframe
            src="https://www.youtube.com/embed/dQw4w9WgXcQ"
            title="Rick Astley"
            allowfullscreen>
        </iframe>
    </div>

</div>

<div class="dashboard-grid">

    <div class="dashboard-card dashboard-card-primary">
        <span class="dashboard-card-label">
            DOCUMENTACIÓN
        </span>

        <strong>📚 Manuales</strong>

        <span>
            Consulta documentación y guías de referencia.
        </span>
    </div>

    <div class="dashboard-card dashboard-card-dark">
        <span class="dashboard-card-label">
            TUTORIALES
        </span>

        <strong>🎓 Aprendizaje</strong>

        <span>
            Aprende mediante videos y ejemplos prácticos.
        </span>
    </div>

    <div class="dashboard-card dashboard-card-status">
        <span class="dashboard-card-label">
            SEGURIDAD
        </span>

        <div class="status-line">
            <span class="status-dot"></span>
            <strong>Protegido</strong>
        </div>

        <span>
            Información y buenas prácticas de seguridad.
        </span>
    </div>

</div>

<br />

<div class="task-list">

    <div class="task-list-heading">
        <h2>Recursos Disponibles</h2>
        <span>4 elementos</span>
    </div>

    <div class="task-row">
        <div class="task-copy">
            <h3>📖 Manual de Usuario</h3>
            <p>Guía para utilizar correctamente el sistema.</p>
        </div>
    </div>

    <div class="task-row">
        <div class="task-copy">
            <h3>🎥 Tutorial en Video</h3>
            <p>Aprende rápidamente las funcionalidades principales.</p>
        </div>
    </div>

    <div class="task-row">
        <div class="task-copy">
            <h3>🔒 Políticas de Seguridad</h3>
            <p>Información relacionada con accesos y protección de datos.</p>
        </div>
    </div>

    <div class="task-row">
        <div class="task-copy">
            <h3>❓ Preguntas Frecuentes</h3>
            <p>Respuestas a las consultas más comunes de los usuarios.</p>
        </div>
    </div>

</div>