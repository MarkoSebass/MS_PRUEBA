@{
    ViewData["Title"] = "Centro de Información";
}

<div class="hero-section">
    <div class="hero-content">
        <span class="eyebrow">📚 RECURSOS DEL SISTEMA</span>
        <h1>@ViewData["Title"]</h1>
        <p>
            Encuentra tutoriales, documentación, recursos de ayuda e información
            importante para aprovechar al máximo la plataforma.
        </p>
    </div>
</div>

<div class="container-info">

    <div class="featured-card">
        <div class="featured-text">
            <h2>🎥 Video Tutorial Principal</h2>
            <p>
                Aprende las funcionalidades principales del sistema mediante un
                video explicativo.
            </p>
            <a href="https://www.youtube.com" targetVer Video
            </a>
        </div>

        <div class="featured-image">
            <imgs://picsum.photos/600/350
        </div>
    </div>

    <div class="cards-grid">

        <div class="info-card">
            <div class="icon">📚</div>
            <h3>Documentación</h3>
            <p>
                Consulta manuales y guías para resolver dudas rápidamente.
            </p>
        </div>

        <div class="info-card">
            <div class="icon">🎓</div>
            <h3>Tutoriales</h3>
            <p>
                Aprende paso a paso a utilizar cada módulo del sistema.
            </p>
        </div>

        <div class="info-card">
            <div class="icon">🔒</div>
            <h3>Seguridad</h3>
            <p>
                Información sobre protección de datos y buenas prácticas.
            </p>
        </div>

        <div class="info-card">
            <div class="icon">❓</div>
            <h3>Preguntas Frecuentes</h3>
            <p>
                Encuentra respuestas a las consultas más comunes.
            </p>
        </div>

    </div>

</div>

<style>

    body {
        background: #f5f7fb;
    }

    .hero-section {
        background: linear-gradient(135deg, #0d6efd, #4f9dff);
        color: white;
        padding: 50px;
        border-radius: 20px;
        margin-bottom: 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }

    .eyebrow {
        font-weight: bold;
        letter-spacing: 2px;
        opacity: .9;
    }

    .hero-section h1 {
        margin-top: 10px;
        font-size: 3rem;
        font-weight: 700;
    }

    .hero-section p {
        font-size: 1.1rem;
        max-width: 700px;
    }

    .container-info {
        max-width: 1200px;
        margin: auto;
    }

    .featured-card {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        background: white;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

    .featured-text {
        flex: 1;
        min-width: 300px;
    }

    .featured-image {
        flex: 1;
        min-width: 300px;
    }

    .featured-image img {
        width: 100%;
        border-radius: 15px;
        height: 100%;
        object-fit: cover;
    }

    .btn-custom {
        display: inline-block;
        margin-top: 15px;
        background: #0d6efd;
        color: white;
        text-decoration: none;
        padding: 12px 25px;
        border-radius: 10px;
        transition: .3s;
    }

    .btn-custom:hover {
        background: #0b5ed7;
        color: white;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
        gap: 20px;
    }

    .info-card {
        background: white;
        padding: 25px;
        border-radius: 18px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
        transition: .3s;
    }

    .info-card:hover {
        transform: translateY(-8px);
    }

    .icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .info-card h3 {
        color: #0d6efd;
        margin-bottom: 10px;
    }

    .info-card p {
        color: #6c757d;
    }

</style>