@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="error-page">
    <div class="error-mark" aria-hidden="true">!</div>
    <span class="eyebrow">ALGO NO SALIÓ COMO ESPERÁBAMOS</span>
    <h1>Volvamos<br /><span>al tablero.</span></h1>
    <p>Ocurrió un problema al cargar esta página. Puedes regresar al inicio y continuar desde ahí.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ir al inicio <span aria-hidden="true">↗</span></a>

    @if (Model.ShowRequestId)
    {
        <small class="error-request">Referencia: <code>@Model.RequestId</code></small>
    }
</section>
