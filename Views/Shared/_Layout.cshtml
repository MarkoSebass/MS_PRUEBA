<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MsPrueba</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MsPrueba.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm site-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">M</span>
                    <span>MsPrueba</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container site-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-main">
                <div class="footer-brand">
                    <a class="footer-logo" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-icon">M</span>
                        <span>MsPrueba</span>
                    </a>
                    <p>Una base clara y segura para convertir tus ideas en productos digitales.</p>
                </div>
                <div class="footer-column">
                    <h2>Explora</h2>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>
                <div class="footer-column">
                    <h2>Tu cuenta</h2>
                    <a asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
                    <a asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a>
                </div>
                <div class="footer-contact">
                    <span class="footer-kicker">EMPIEZA HOY</span>
                    <p>Tu próximo proyecto merece un buen comienzo.</p>
                    <a class="footer-cta" asp-area="Identity" asp-page="/Account/Register">Crear mi cuenta <span aria-hidden="true">↗</span></a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 MsPrueba. Todos los derechos reservados.</span>
                <span class="footer-status"><span aria-hidden="true"></span> Sistema disponible</span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
